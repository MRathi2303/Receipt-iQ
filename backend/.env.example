# =========================================================
#  ReceiptIQ — Environment Variables
#  Copy this file to .env and fill in the values when you are ready
#  NEVER commit .env to git — add it to .gitignore
# =========================================================

# ── SERVER ──────────────────────────────────────────────
PORT=4000

# Local frontend URL used by the Express server
FRONTEND_URL=http://localhost:4000

# Optional gateway key. JWT authentication remains the primary application boundary.
# API_KEY=YOUR_STRONG_RANDOM_API_KEY

# A strong random string used to sign login tokens
JWT_SECRET=YOUR_STRONG_JWT_SECRET
JWT_SECRET_SECRET_ARN=


# ── AWS CREDENTIALS ──────────────────────────────────────
# Use an AWS profile/role for live deployment; do not put access keys in .env.
AWS_REGION=us-east-1
# Set this only for LocalStack development.
AWS_ENDPOINT_URL=http://localhost:4566


# ── S3 ────────────────────────────────────────────────────
# Receipt uploads bucket name
S3_BUCKET_NAME=your-receiptiq-bucket-name


# ── DYNAMODB ─────────────────────────────────────────────
# DynamoDB table with primary key: docId (String)
DYNAMODB_TABLE_NAME=receiptiq-receipts-table
DYNAMODB_USERS_TABLE=receiptiq-users-table


# ── GOOGLE GEMINI AI (OPTIONAL) ───────────────────────────
# The deterministic OCR/parser path remains available without this key.
AI_PROVIDER=gemini
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
GOOGLE_MODEL=gemini-3.8-flash

# OpenAI-compatible providers remain supported when preferred:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=YOUR_HOSTED_MODEL_API_KEY
# AI_MODEL=YOUR_FREE_MODEL_NAME


# You can leave the AWS values empty until you are ready to connect the live pipeline.
